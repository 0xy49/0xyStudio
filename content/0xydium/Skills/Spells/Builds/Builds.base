filters:
  and:
    - file.folder.endsWith("Skills/Spells/Builds")
    - file.ext == "md"
formulas:
  tier_group: if(tier == "S", "1 · Tier S", if(tier == "A", "2 · Tier A", if(tier == "B", "3 · Tier B", if(tier == "C", "4 · Tier C", "5 · Tier D"))))
  coverage_label: coverage.toString() + "/6"
properties:
  file.name:
    displayName: Build
  aliases:
    displayName: Nom
  tier:
    displayName: Tier
  formula.coverage_label:
    displayName: Couverture
  formula.tier_group:
    displayName: Tier
  schools:
    displayName: Écoles
  hard_counters:
    displayName: Contres durs
  threats:
    displayName: Menaces
  uncovered:
    displayName: Non couvertes
  pivot:
    displayName: Pivot
  profile:
    displayName: Profil
  recommended_class:
    displayName: Classe conseillée
  recommended:
    displayName: Recommandée
  closed_cycle:
    displayName: Cycle fermé
views:
  - type: table
    name: Tous les builds
    groupBy:
      property: formula.tier_group
      direction: ASC
    order:
      - file.name
      - aliases
      - formula.coverage_label
      - profile
      - recommended_class
      - hard_counters
      - threats
  - type: table
    name: Couverture complète
    filters:
      and:
        - tier == "S"
    order:
      - file.name
      - aliases
      - profile
      - recommended_class
      - threats
      - pivot
  - type: table
    name: Recommandées
    filters:
      and:
        - recommended
    order:
      - file.name
      - aliases
      - recommended_class
      - profile
      - threats
      - pivot
  - type: table
    name: Par classe
    groupBy:
      property: recommended_class
      direction: ASC
    order:
      - file.name
      - aliases
      - tier
      - formula.coverage_label
      - profile
      - hard_counters
      - threats
  - type: table
    name: Cycles fermés
    filters:
      and:
        - closed_cycle
    order:
      - file.name
      - aliases
      - tier
      - formula.coverage_label
      - hard_counters
      - uncovered
  - type: table
    name: À éviter
    filters:
      or:
        - tier == "C"
        - tier == "D"
    groupBy:
      property: tier
      direction: ASC
    order:
      - file.name
      - aliases
      - formula.coverage_label
      - hard_counters
      - uncovered
